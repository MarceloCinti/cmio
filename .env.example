# =====================================================================
# CMIO — Variables de entorno (ejemplo)
# Copia este archivo como `.env` y completa los valores.
# Este archivo NO debe contener secretos reales: nunca subas `.env` al repositorio.
# =====================================================================

# --- Aplicación ------------------------------------------------------
# Conexión a PostgreSQL 16+. En producción usa un usuario de base de datos
# propio de la aplicación (sin privilegios de superusuario).
DATABASE_URL="postgresql://cmio:CAMBIAR@localhost:5432/cmio_dev"

# URL pública del sitio (se usa en enlaces de correos e invitaciones).
# En producción debe empezar con https://
APP_URL="http://localhost:3000"

# Secreto para la tarea programada /api/cron (mínimo 32 caracteres).
# Genera uno con: openssl rand -hex 32
CRON_SECRET=""

# "true" solo si la aplicación está detrás de un proxy inverso de confianza
# (Nginx, Caddy, balanceador) que define X-Forwarded-For. Afecta los límites por IP.
TRUST_PROXY="false"

# Modo demostración: permite cargar datos ficticios con `pnpm db:seed:demo`.
# Debe ser "false" en producción (el script se niega a correr con NODE_ENV=production).
DEMO_MODE="false"

# --- Cuenta inicial de propietario (solo para `pnpm db:seed`) --------
# Se crea una única vez si no existe. Contraseña de al menos 12 caracteres.
# Borra OWNER_PASSWORD del entorno después del primer arranque.
OWNER_EMAIL=""
OWNER_NAME=""
OWNER_PASSWORD=""

# --- Correo electrónico ----------------------------------------------
# smtp     → envío real mediante el servidor SMTP indicado abajo.
# file     → solo desarrollo/pruebas: guarda los correos como archivos en .data/mail.
# disabled → no se envía nada; los mensajes quedan registrados como "No enviado".
EMAIL_DRIVER="disabled"
EMAIL_FROM="CMIO <no-responder@tu-dominio.com.py>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Carpeta para EMAIL_DRIVER=file (opcional).
# EMAIL_FILE_DIR=".data/mail"

# --- WhatsApp Business (API oficial de Meta, Cloud API) --------------
# meta     → envío real con plantillas aprobadas por Meta.
# disabled → no se envía nada; los mensajes quedan registrados como "No enviado".
WHATSAPP_PROVIDER="disabled"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Webhook de estados de entrega: https://TU-DOMINIO/api/webhooks/whatsapp
# Token que defines tú y cargas también en la configuración del webhook en Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# "App secret" de la aplicación de Meta; se usa para validar la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=""

# --- Almacenamiento de archivos --------------------------------------
# Documentos clínicos y archivos privados. La carpeta debe estar FUERA de
# la carpeta pública, tener copias de seguridad y permisos restringidos.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# --- Pruebas automatizadas -------------------------------------------
# Base exclusiva para pruebas: su nombre DEBE terminar en "_test" (se vacía en cada prueba).
TEST_DATABASE_URL="postgresql://cmio:CAMBIAR@localhost:5432/cmio_test"
